# ── LLM ───────────────────────────────────────────────────────
# OPENAI_API_KEY is still required even when LLM_PROVIDER=groq — it's used
# for embeddings (OpenAIEmbeddings has no Groq equivalent) and the eval judge
# in tests/eval_chat.py. Only chat/voice completions move to Groq.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# LLM_PROVIDER selects the chat-completion model for persona responses (chat + voice).
# "groq" (default) is far cheaper/faster than gpt-4o; set to "openai" to fall back.
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ── Voice (Vapi) ───────────────────────────────────────────────
VAPI_API_KEY=...
VAPI_PHONE_NUMBER_ID=...
VAPI_PHONE_NUMBER_DISPLAY=+1 (239) 663 4085
VAPI_WEBHOOK_SECRET=...

# ── GitHub ────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
GITHUB_USERNAME=Akshat030307

# ── Google Calendar ────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=./data/google_credentials.json
GOOGLE_TOKEN_PATH=./data/google_token.json

# ── Candidate Info ─────────────────────────────────────────────
CANDIDATE_NAME=Akshat Chowdhary
CANDIDATE_EMAIL=akshatchowdhary03@gmail.com
CANDIDATE_ROLE_APPLYING=AI Engineer at Scaler
RESUME_PATH=./data/resume/resume.pdf

# ── App Config ─────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
CHROMA_PERSIST_DIR=./data/chroma_db
LOG_LEVEL=INFO

# ── Booking Config ─────────────────────────────────────────────
BOOKING_TIMEZONE=Asia/Kolkata
BOOKING_SLOT_DURATION_MINUTES=30
BOOKING_DAYS_AHEAD=7
BOOKING_DAILY_START_HOUR=10
BOOKING_DAILY_END_HOUR=18

# ── Railway deployment (base64 encoded files) ──────────────────
GOOGLE_CREDENTIALS_B64=
GOOGLE_TOKEN_B64=
RESUME_PDF_B64=